{
  "name": "el-archivo-de-medianoche",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@9.2.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "check": "astro check",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "node --env-file-if-exists=.env scripts/migrate.ts && node --env-file-if-exists=.env scripts/seed.ts",
    "assets": "node --env-file-if-exists=.env scripts/assets.ts",
    "test": "node --env-file-if-exists=.env --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
