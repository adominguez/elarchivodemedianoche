---
/**
 * La pantalla del expediente.
 *
 * Orquesta las capas: repositorio (Turso) → motor → presentación → interfaz.
 * Aquí no hay SQL ni reglas del caso; sólo la traducción de una petición HTTP
 * en una acción de investigación.
 */
import Layout from '@layouts/Layout.astro';
import ArchiveImage from '@components/ArchiveImage.astro';
import Scene from '@components/Scene.astro';
import DiscoveryNotes from '@components/DiscoveryNotes.astro';
import InvestigationActions from '@components/InvestigationActions.astro';
import SuspectFiles from '@components/SuspectFiles.astro';
import EvidenceBoard from '@components/EvidenceBoard.astro';
import ProgressLine from '@components/ProgressLine.astro';
import Verdict from '@components/Verdict.astro';
import AccusationForm from '@components/AccusationForm.astro';

import { getCaseFile } from '@lib/data/caseRepository';
import {
  findOrStartInvestigation,
  lastAccusation,
  loadState,
  persistVisit,
  recordAccusation,
  reopenInvestigation,
  setDifficulty,
} from '@lib/data/progressRepository';
import { canAccuse, canFollow, judgeAccusation, visitNode, type StateChanges } from '@lib/domain/engine';
import { buildDossier } from '@lib/presentation/dossier';
import { readerKey } from '@lib/reader';
import type { Accusation, InvestigationDifficulty } from '@lib/domain/types';

const { slug } = Astro.params;
const caseFile = slug ? await getCaseFile(slug) : null;

if (!caseFile) {
  return new Response('Expediente no encontrado', { status: 404 });
}

const reader = readerKey(Astro.cookies);
const investigationId = await findOrStartInvestigation(caseFile.id, reader);

let state = await loadState(investigationId);
let changes: StateChanges | undefined;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intencion') ?? '');
  const requestedDifficulty = String(form.get('dificultad') ?? '');
  const difficulty = (['narrative', 'detective', 'hound'] as const).includes(requestedDifficulty as InvestigationDifficulty)
    ? requestedDifficulty as InvestigationDifficulty
    : null;

  if ((intent === 'empezar' || intent === 'cambiar-dificultad') && difficulty && state.status === 'open') {
    await setDifficulty(investigationId, difficulty);
    state = { ...state, difficulty };
    if (intent === 'cambiar-dificultad') notice = 'Nivel de investigación actualizado.';
  }

  if (intent === 'empezar' && state.currentNodeId === null) {
    const result = visitNode(caseFile, state, caseFile.entryNodeId);
    await persistVisit(investigationId, caseFile.entryNodeId, result.changes);
    state = result.state;
    changes = result.changes;
  }

  if (intent === 'investigar' && state.status === 'open') {
    const option = canFollow(caseFile, state, String(form.get('opcion') ?? ''));
    if (option) {
      const result = visitNode(caseFile, state, option.targetNodeId);
      await persistVisit(investigationId, option.targetNodeId, result.changes);
      state = result.state;
      changes = result.changes;
    } else {
      notice = 'Esa diligencia ya no está disponible.';
    }
  }

  if (intent === 'acusar' && state.status === 'open') {
    if (!canAccuse(caseFile, state)) {
      notice = 'Antes de acusar debe completar la diligencia urgente pendiente.';
    } else {
    const accusation: Accusation = {
      culpritSuspectId: String(form.get('culpable') ?? ''),
      motiveOptionId: String(form.get('motivo') ?? ''),
      methodOptionId: String(form.get('metodo') ?? ''),
      evidenceClueIds: form
        .getAll('evidencia')
        .map(String)
        // Sólo cuenta como evidencia lo que realmente se ha encontrado.
        .filter((clueId) => state.clueStates.has(clueId)),
    };

    const complete =
      accusation.culpritSuspectId !== '' &&
      accusation.motiveOptionId !== '' &&
      accusation.methodOptionId !== '';

    if (complete) {
      await recordAccusation(investigationId, accusation, judgeAccusation(caseFile, accusation, state));
      state = await loadState(investigationId);
    } else {
      notice = 'La acusación necesita culpable, motivo y método.';
    }
    }
  }

  if (intent === 'reabrir') {
    await reopenInvestigation(investigationId);
    state = await loadState(investigationId);
  }
}

const accusation = await lastAccusation(investigationId);
const dossier = buildDossier({ caseFile, state, changes, accusation });
const started = state.currentNodeId !== null;
const { header } = dossier;
const victimDisplayName = header.victimName?.replace(/^v[ií]ctima\s*:\s*/i, '').trim() || null;
---

<Layout
  title={`${header.fileCode} ${header.title} — El Archivo de Medianoche`}
  description={header.briefing}
>
  <main class="mx-auto max-w-6xl px-4 pb-24 pt-8 sm:px-6 lg:px-8">
    <header class="border-b border-parchment-400/20 pb-6">
      <a href="/" class="typed-sm text-parchment-400 hover:text-gold-400">
        ← El Archivo de Medianoche
      </a>

      <div class="mt-4 flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
        <div>
          <p class="typed text-sm text-blood-bright">Expediente {header.fileCode}</p>
          <h1 class="mt-1 font-narrative text-4xl leading-none text-parchment-50 sm:text-5xl">
            {header.title}
          </h1>
          {
            header.subtitle && (
              <p class="mt-2 font-narrative text-xl italic text-parchment-300">{header.subtitle}</p>
            )
          }
        </div>

        <dl class="typed-sm space-y-1 text-parchment-400">
          {header.place && <div><dt class="sr-only">Lugar</dt><dd>{header.place}</dd></div>}
          {header.dateLabel && <div><dt class="sr-only">Fecha</dt><dd>{header.dateLabel}</dd></div>}
          {
            victimDisplayName && (
              <div><dt class="sr-only">Víctima</dt><dd>Víctima: {victimDisplayName}</dd></div>
            )
          }
        </dl>
      </div>

      {
        started && (
          <div class="mt-6 grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
            <ProgressLine progress={dossier.progress} closed={dossier.closed} />
            <div class="flex flex-wrap gap-2 sm:justify-end">
              {!dossier.closed && (
                <form method="post" class="difficulty-switch" aria-label="Nivel de investigación">
                  <input type="hidden" name="intencion" value="cambiar-dificultad" />
                  <span>Nivel</span>
                  {(['narrative', 'detective', 'hound'] as const).map((level) => (
                    <button type="submit" name="dificultad" value={level} aria-pressed={dossier.difficulty === level}>
                      {level === 'narrative' ? 'Narrativo' : level === 'detective' ? 'Detective' : 'Sabueso'}
                    </button>
                  ))}
                </form>
              )}
              <button type="button" class="summary-shortcut" data-open-summary>
                <span aria-hidden="true">▣</span>
                Ver resumen
              </button>
              {!dossier.closed && (
                <button type="button" class="resolve-shortcut" data-open-resolver aria-controls="resolver-expediente" aria-expanded="false">
                  <span class="resolve-shortcut__mark" aria-hidden="true">⚖</span>
                  Resolver expediente
                </button>
              )}
            </div>
          </div>
        )
      }
    </header>

    {started && (
      <dialog class="investigation-summary" data-investigation-summary aria-labelledby="summary-title">
        <div class="investigation-summary__paper">
          <header class="investigation-summary__header">
            <div>
              <p class="typed-sm text-blood">Informe de progreso · {header.fileCode}</p>
              <h2 id="summary-title">Resumen de la investigación</h2>
              <p class="summary-case-title">{header.title}{header.place && <span> · {header.place}</span>}</p>
            </div>
            <span class="summary-status">{dossier.closed ? 'Cerrado' : `Nivel ${dossier.difficultyLabel}`}</span>
            <button type="button" class="investigation-summary__close" data-close-summary aria-label="Cerrar resumen">×</button>
          </header>

          <div class="investigation-summary__metrics">
            <div class="investigation-summary__progress">
              <div class="summary-ring" style={`--summary-progress: ${dossier.progress.percent}%`}><strong>{dossier.progress.percent}%</strong></div>
              <p>{dossier.closed ? 'Expediente cerrado' : 'Investigación en curso'}</p>
              <small>Nivel {dossier.difficultyLabel}: exige {dossier.accusationForm.evidenceRequired} de {dossier.accusationForm.evidenceGroupsTotal} aspectos</small>
            </div>
            <dl>
              <div><dt>Pistas</dt><dd>{dossier.progress.cluesFound} <span>de {dossier.progress.cluesTotal}</span></dd></div>
              <div><dt>Anotaciones</dt><dd>{dossier.progress.factsFound} <span>de {dossier.progress.factsTotal}</span></dd></div>
              <div><dt>Diligencias</dt><dd>{dossier.progress.nodesVisited} <span>de {dossier.progress.nodesTotal}</span></dd></div>
            </dl>
          </div>

          <div class="investigation-summary__columns">
            <section>
              <h3>Sospechosos</h3>
              <ul class="summary-suspects">
                {dossier.suspects.map((suspect, index) => (
                  <li>
                    <button type="button" class="summary-card-button" popovertarget={`summary-suspect-${index}`}>
                      <ArchiveImage image={suspect.thumb} alt={`Retrato de ${suspect.name}`} placeholder={suspect.initials} ratio="1 / 1" />
                      <span class="summary-card-copy"><strong>{suspect.name}</strong><span>{suspect.factsKnown} de {suspect.factsTotal} anotaciones</span></span>
                      <span class="summary-card-open" aria-hidden="true">Abrir ficha&nbsp; →</span>
                    </button>
                    <aside id={`summary-suspect-${index}`} class="summary-detail" popover="auto">
                      <button type="button" class="summary-detail__close" popovertarget={`summary-suspect-${index}`} popovertargetaction="hide" aria-label={`Cerrar ficha de ${suspect.name}`}>×</button>
                      <div class="summary-detail__portrait"><ArchiveImage image={suspect.portrait} alt={`Retrato de ${suspect.name}`} placeholder={suspect.initials} ratio="4 / 5" /></div>
                      <div class="summary-detail__body">
                        <p class="summary-detail__eyebrow">Ficha de sospechoso</p>
                        <h4>{suspect.name}</h4>
                        <p class="summary-detail__role">{suspect.role}</p>
                        <p>{suspect.description}</p>
                        {suspect.relation && <p class="summary-detail__relation">{suspect.relation}</p>}
                        <h5>Anotaciones conocidas</h5>
                        {suspect.facts.length > 0 ? (
                          <ul class="summary-detail__facts">{suspect.facts.map((fact) => <li><small>{fact.kindLabel}</small><strong>{fact.headline}</strong><p>{fact.detail}</p></li>)}</ul>
                        ) : <p class="summary-empty">Aún no has descubierto información sobre esta persona.</p>}
                      </div>
                    </aside>
                  </li>
                ))}
              </ul>
            </section>
            <section>
              <h3>Pistas encontradas</h3>
              {dossier.progress.cluesFound > 0 ? (
                <ul class="summary-clues">
                  {dossier.evidence.map((slot, index) => slot.known && (
                    <li>
                      <button type="button" class="summary-clue-button" popovertarget={`summary-clue-${index}`}>
                        <ArchiveImage image={slot.thumb} alt={slot.name} placeholder={slot.name} ratio="1 / 1" />
                        <span>{slot.name}</span>
                        <small aria-hidden="true">Examinar</small>
                      </button>
                      <aside id={`summary-clue-${index}`} class="summary-detail summary-detail--clue" popover="auto">
                        <button type="button" class="summary-detail__close" popovertarget={`summary-clue-${index}`} popovertargetaction="hide" aria-label={`Cerrar detalle de ${slot.name}`}>×</button>
                        <div class="summary-detail__evidence"><ArchiveImage image={slot.detail} alt={slot.name} placeholder={slot.name} ratio="4 / 3" /></div>
                        <div class="summary-detail__body">
                          <p class="summary-detail__eyebrow">{slot.kindLabel}</p>
                          <h4>{slot.stateLabel}</h4>
                          <p>{slot.description}</p>
                          {slot.foundAt && <p class="summary-detail__relation">{slot.foundAt}</p>}
                        </div>
                      </aside>
                    </li>
                  ))}
                </ul>
              ) : <p class="summary-empty">Todavía no has incorporado ninguna pista al expediente.</p>}
            </section>
          </div>

          <footer><button type="button" class="summary-close-button" data-close-summary>Volver a la investigación</button></footer>
        </div>
      </dialog>
    )}

    {
      notice && (
        <p class="typed-sm mt-6 border-l-2 border-blood-bright pl-3 text-blood-bright">{notice}</p>
      )
    }

    {
      !started ? (
        <section class="mt-10 grid gap-8 md:grid-cols-[18rem_minmax(0,1fr)] md:items-start">
          <div class="photo taped mx-auto w-full max-w-xs md:mx-0">
            <ArchiveImage
              image={header.cover}
              alt={`Portada del expediente ${header.fileCode}`}
              placeholder={header.title}
              ratio="4 / 5"
              loading="eager"
            />
          </div>

          <div class="paper paper-ruled">
            <div class="px-5 py-7 sm:px-8">
              <p class="typed-sm text-blood">Informe preliminar</p>
              <div class="narrative mt-4 max-w-[62ch]">
                <p>{header.briefing}</p>
              </div>

              <form method="post" class="mt-8 border-t border-ink-500/25 pt-6">
                <input type="hidden" name="intencion" value="empezar" />
                <fieldset class="difficulty-picker">
                  <legend>Elige el nivel de investigación</legend>
                  <label><input type="radio" name="dificultad" value="narrative" /><strong>Narrativo</strong><span>Una investigación más flexible, centrada en la historia.</span></label>
                  <label><input type="radio" name="dificultad" value="detective" checked /><strong>Detective</strong><span>Exige una teoría bien respaldada y sólo pruebas pertinentes. Recomendado.</span></label>
                  <label><input type="radio" name="dificultad" value="hound" /><strong>Sabueso</strong><span>Debes acreditar todos los aspectos sin aportar pistas irrelevantes.</span></label>
                </fieldset>
                <button
                  type="submit"
                  class="stamp border-blood text-blood transition-transform hover:rotate-0"
                >
                  Abrir el expediente
                </button>
              </form>
            </div>
          </div>
        </section>
      ) : (
        <div class="investigation-layout mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_21rem] lg:gap-12">
          <div class="investigation-main space-y-10">
            {dossier.scene && <Scene scene={dossier.scene} />}

            <DiscoveryNotes notices={dossier.notices} />

            {dossier.verdict && <Verdict verdict={dossier.verdict} />}

            {!dossier.closed && dossier.continuations.length > 0 && (
              <InvestigationActions options={dossier.continuations} />
            )}

            {!dossier.closed && (
              <InvestigationActions
                title="¿Qué quiere investigar ahora?"
                groups={dossier.investigationLines}
              />
            )}

            {dossier.closed ? (
              <form method="post">
                <input type="hidden" name="intencion" value="reabrir" />
                <button type="submit" class="typed-sm text-parchment-400 hover:text-gold-400">
                  Volver a abrir el expediente desde el principio
                </button>
              </form>
            ) : (
              <details class="card-dark scroll-mt-6" id="resolver-expediente">
                <summary class="flex items-center justify-between gap-4 p-5">
                  <span class="typed text-sm text-blood-bright">Resolver el expediente</span>
                  <span class="disclosure-mark text-gold-500" aria-hidden="true" />
                </summary>
                <div class="border-t border-parchment-400/20 p-5 sm:p-7">
                  {dossier.canAccuse ? (
                    <>
                      <p class="mb-7 max-w-prose font-narrative leading-relaxed text-parchment-200/80">
                        No hace falta haberlo descubierto todo. Hace falta poder sostenerlo con pruebas precisas.
                      </p>
                      <AccusationForm form={dossier.accusationForm} />
                    </>
                  ) : (
                    <p class="max-w-prose font-narrative leading-relaxed text-parchment-200/80">
                      Antes de formular una acusación debe completar la diligencia urgente pendiente.
                    </p>
                  )}
                </div>
              </details>
            )}
          </div>

          <aside class="investigation-sidebar space-y-6 lg:sticky lg:top-8 lg:max-h-[calc(100vh-4rem)] lg:self-start lg:overflow-y-auto lg:pr-1">
            <details class="card-dark" data-open-on-desktop>
              <summary class="flex items-center justify-between gap-4 px-4 py-3">
                <span class="typed text-sm text-gold-400">Sospechosos</span>
                <span class="disclosure-mark text-gold-500" aria-hidden="true" />
              </summary>
              <div class="border-t border-parchment-400/20 p-3">
                <SuspectFiles suspects={dossier.suspects} />
              </div>
            </details>

            <details class="card-dark" data-open-on-desktop>
              <summary class="flex items-center justify-between gap-4 px-4 py-3">
                <span class="typed text-sm text-gold-400">
                  Evidencias {dossier.progress.cluesFound}/{dossier.progress.cluesTotal}
                </span>
                <span class="disclosure-mark text-gold-500" aria-hidden="true" />
              </summary>
              <div class="border-t border-parchment-400/20 p-3">
                <EvidenceBoard evidence={dossier.evidence} />
              </div>
            </details>
          </aside>
        </div>
      )
    }
  </main>

  <script>
    // En escritorio el expediente permanece a la vista; en móvil se despliega
    // a demanda para no tapar la narración.
    const desktop = window.matchMedia('(min-width: 1024px)');
    const panels = document.querySelectorAll<HTMLDetailsElement>('[data-open-on-desktop]');
    const sync = (matches: boolean) => panels.forEach((panel) => (panel.open = matches));
    sync(desktop.matches);
    desktop.addEventListener('change', (event) => sync(event.matches));

    const resolver = document.querySelector<HTMLDetailsElement>('#resolver-expediente');
    if (window.location.hash === '#resolver-expediente') {
      history.replaceState(null, '', `${window.location.pathname}${window.location.search}`);
      window.scrollTo(0, 0);
    }

    document.querySelectorAll<HTMLButtonElement>('[data-open-resolver]').forEach((shortcut) => {
      shortcut.addEventListener('click', () => {
        if (!resolver) return;
        resolver.setAttribute('open', '');
        shortcut.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => {
          resolver.scrollIntoView({ behavior: 'smooth', block: 'start' });
          resolver.querySelector<HTMLElement>('summary, input, button')?.focus({ preventScroll: true });
        });
      });
    });
    resolver?.addEventListener('toggle', () => {
      document.querySelectorAll<HTMLButtonElement>('[data-open-resolver]').forEach((shortcut) => {
        shortcut.setAttribute('aria-expanded', String(resolver.open));
      });
    });

    const summary = document.querySelector<HTMLDialogElement>('[data-investigation-summary]');
    document.querySelector<HTMLButtonElement>('[data-open-summary]')?.addEventListener('click', () => summary?.showModal());
    document.querySelectorAll<HTMLButtonElement>('[data-close-summary]').forEach((button) => {
      button.addEventListener('click', () => summary?.close());
    });
    summary?.addEventListener('click', (event) => {
      if (event.target === summary) summary.close();
    });
  </script>
</Layout>
