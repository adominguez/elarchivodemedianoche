---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Expediente no encontrado — El Archivo de Medianoche">
  <main class="mx-auto flex min-h-screen max-w-lg flex-col items-center justify-center px-6 text-center">
    <p class="stamp text-blood-bright">Expediente no localizado</p>
    <p class="mt-8 font-narrative text-xl leading-relaxed text-parchment-200">
      La carpeta no está en su cajón. O nunca lo estuvo, y alguien se tomó la molestia de
      recolocar las demás para que no se notara.
    </p>
    <a href="/" class="typed-sm mt-10 text-gold-400 hover:text-gold-500">
      ← Volver al archivo
    </a>
  </main>
</Layout>
